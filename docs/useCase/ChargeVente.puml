@startuml UC_Vente
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome

actor "Chargé de Vente" as VEN


rectangle " StoreManager " {
  usecase "S'authentifier" as L2

  usecase "Effectuer une vente POS" as UC1
  usecase "Sélectionner un client" as UC1a
  usecase "Ajouter des produits au panier" as UC1b
  usecase "Vérifier le stock disponible" as UC1c
  usecase "Saisir montant via clavier" as UC1d
  usecase "Valider la commande" as UC1e

  usecase "Consulter les dettes clients" as UC2
  usecase "Filtrer / rechercher un débiteur" as UC2a

  usecase "Enregistrer un paiement de dette" as UC3
  usecase "Choisir un montant suggéré" as UC3a

  usecase "Générer une relance SMS" as UC4
  usecase "Copier le message de relance" as UC4a
}

VEN --> L2
VEN --> UC1
VEN --> UC2
VEN --> UC3
VEN --> UC4

UC1 ..> UC1a : <<include>>
UC1 ..> UC1b : <<include>>
UC1 ..> UC1c : <<include>>
UC1 ..> UC1d : <<include>>
UC1 ..> UC1e : <<include>>


UC2 ..> UC2a : <<include>>
UC3 ..> UC3a : <<include>>
UC4 ..> UC4a : <<include>>


@enduml