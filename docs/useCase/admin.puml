@startuml UC_Admin
left to right direction

actor "Admin Boutique" as ADM


rectangle "StoreManager" {
  usecase "S'authentifier" as L1


  usecase "Effectuer une vente POS" as UC2
  usecase "Sélectionner un client" as UC2a
  usecase "Ajouter des produits au panier" as UC2b
  usecase "Vérifier le stock disponible" as UC2c
  usecase "Saisir montant via clavier" as UC2d
  usecase "Valider la commande" as UC2e

  usecase "Gérer les dettes clients" as UC3
  usecase "Filtrer / rechercher un débiteur" as UC3a
  usecase "Enregistrer un paiement de dette" as UC3b
  usecase "Générer une relance SMS" as UC3c
  usecase "Copier le message de relance" as UC3d

  usecase "Gérer les approvisionnements" as UC4
  usecase "Créer un approvisionnement" as UC4a
  usecase "Réapprovisionner un produit en rupture" as UC4b
  usecase "Réceptionner une livraison" as UC4c
  usecase "Saisir quantités reçues par article" as UC4d
  usecase "Payer un fournisseur / une facture" as UC4e

  usecase "Gérer le catalogue" as UC5
  usecase "Ajouter / rechercher un produit" as UC5a
  usecase "Enregistrer un client" as UC5b
  usecase "Enregistrer un fournisseur" as UC5c
}

ADM --> L1

ADM --> UC2
ADM --> UC3
ADM --> UC4
ADM --> UC5


UC2 ..> UC2a : <<include>>
UC2 ..> UC2b : <<include>>
UC2 ..> UC2c : <<include>>
UC2 ..> UC2d : <<include>>
UC2 ..> UC2e : <<include>>


UC3 ..> UC3a : <<include>>
UC3 ..> UC3b : <<include>>
UC3c ..> UC3 : <<extend>>
UC3c ..> UC3d : <<include>>


UC4 ..> UC4a : <<include>>
UC4b ..> UC4 : <<extend>>
UC4 ..> UC4c : <<include>>
UC4c ..> UC4d : <<include>>
UC4 ..> UC4e : <<include>>



UC5 ..> UC5a : <<include>>
UC5 ..> UC5b : <<include>>
UC5 ..> UC5c : <<include>>
@enduml